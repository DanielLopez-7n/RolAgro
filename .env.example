# Copia este archivo a ".env" y completa tus valores reales.
# El archivo ".env" NUNCA debe subirse al repositorio.

PORT=3000

# "production" activa trust proxy (necesario detrás de Nginx), el log
# "combined" de morgan y CSP sin relajar por defaults de desarrollo.
NODE_ENV=development

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=rolagro_db
# Poner "true" solo si el MySQL vive en otro host que exige TLS (no aplica
# a un MySQL instalado en el mismo VPS).
DB_SSL=false

# --- Nodemailer (Gmail con App Password) ---
# Genera una "contraseña de aplicación" en tu cuenta de Google
# (Seguridad > Verificación en 2 pasos > Contraseñas de aplicaciones).
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
MAIL_TO=pedidos@rolagro.com

# --- Panel de administración (/admin) ---
# Credenciales para entrar al panel: el navegador las pedirá al abrirlo.
# Si faltan, /admin responde 503 y queda deshabilitado (nunca abierto).
# En producción la contraseña debe tener 12 caracteres o más: con menos, el
# proceso no arranca (ver src/config/env.js). Una frase larga y fácil de
# recordar sirve mejor que ocho caracteres con símbolos.
ADMIN_USER=admin
ADMIN_PASS=cambia_esta_clave

# Firma la cookie de sesión del panel. No se escribe a mano: se genera al azar
# una sola vez, por servidor, con
#   openssl rand -base64 32
# Cambiarla cierra todas las sesiones abiertas (útil si sospechás algo raro).
SESSION_SECRET=genera_esta_clave_con_openssl_rand_base64_32

# --- WhatsApp ---
# Número de la empresa en formato internacional, sin "+" ni espacios.
WHATSAPP_NUMBER=549XXXXXXXXXX
